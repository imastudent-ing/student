# ---------------------------------------------------------------------------
# LAPTOP Base first-block sniper — configuration
# Copy to .env (never commit .env). All values have safe defaults except
# PRIVATE_KEY, which is only needed for MODE=dry_run / live.
# ---------------------------------------------------------------------------

# listen   : dry-run listener. Logs PoolManager events, no wallet needed.
# dry_run  : full pipeline incl. signing + eth_call simulation, never sends.
# live     : sends the buy.
MODE=listen

# Base Flashblocks endpoints. The public preconf WSS is documented for
# pendingLogs; if eth_subscribe is refused there, point WS_URL at a
# Flashblocks-aware WebSocket provider (Alchemy/QuickNode/etc.).
WS_URL=wss://mainnet-preconf.base.org
RPC_URL=https://mainnet-preconf.base.org
# Comma-separated list of endpoints that receive eth_sendRawTransaction in parallel.
# Defaults to RPC_URL.
#SEND_URLS=https://mainnet-preconf.base.org,https://mainnet.base.org

CHAIN_ID=8453
# Uniswap v4 on Base (docs.uniswap.org/contracts/v4/deployments)
POOL_MANAGER=0x498581ff718922c3f8e6a244956af099b2652b2b
# v2 -> UniversalRouterV2 0x6ff5693b99212da76ad316178a184ab56d299b43 (5-field ExactInputSingleParams)
# v2_1_1 -> UniversalRouter 2.1.1 0xfdf682f51fe81aa4898f0ae2163d8a55c127fbc7 (adds minHopPriceX36)
ROUTER_VERSION=v2
#UNIVERSAL_ROUTER=0x6ff5693b99212da76ad316178a184ab56d299b43

TARGET_TOKEN=0xb095274743941e953c746f9c228da9c18bb6ec29
# eth (native, address(0)) | weth | 0x<address>
COUNTER_CURRENCY=eth

# Pool verification. A pool whose hooks address is not listed is REFUSED.
ALLOWED_HOOKS=0x0000000000000000000000000000000000000000
# Optional comma lists (or "any"). Example: ALLOWED_FEES=3000,10000
#ALLOWED_FEES=any
#ALLOWED_TICK_SPACINGS=any

# liquidity  : buy on first positive ModifyLiquidity for the pool (default)
# initialize : buy on Initialize (reverts + wastes gas if liquidity comes later)
TRIGGER=liquidity
MIN_LIQUIDITY_DELTA=1

# Spend limits (ETH, decimal). BUY_AMOUNT_ETH must be <= MAX_BUY_AMOUNT_ETH.
BUY_AMOUNT_ETH=0.01
MAX_BUY_AMOUNT_ETH=0.1
# Price protection: amountOutMinimum = max(quote_at_init_price * (1 - SLIPPAGE_BPS/10000), MIN_OUT_TOKENS)
SLIPPAGE_BPS=3000
TOKEN_DECIMALS=18
MIN_OUT_TOKENS=0

GAS_LIMIT=500000
MAX_FEE_PER_GAS_GWEI=0.1
PRIORITY_FEE_GWEI=0.01
DEADLINE_SECS=120

# Dedicated hot wallet only. Never commit.
#PRIVATE_KEY=0x...

LOG_FILE=sniper.jsonl
RESULT_FILE=result.json
REFRESH_SECS=15
# Look back N blocks for an Initialize of the target pool at startup (0 = off).
STARTUP_SCAN_BLOCKS=0
RECEIPT_POLL_MS=100
RECEIPT_TIMEOUT_SECS=90
SIMULATE_IN_DRY_RUN=true
QUIET=false

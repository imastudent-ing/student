# ===== 必須 =====
# 監視したい出金元ウォレット (カンマ区切りで複数指定可)
FUNDING_WALLETS=WalletAddress1,WalletAddress2

# ===== RPC (推奨: Helius等の無料APIキー。公共RPCはWebSocketが不安定) =====
RPC_HTTP_URL=https://api.mainnet-beta.solana.com
# RPC_WS_URL=wss://... (未指定ならHTTP URLから自動導出)

# ===== 通知先 (どちらか一方でも両方でもOK) =====
# Telegram: @BotFather でボット作成 → トークン取得。チャットIDは @userinfobot 等で確認
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: サーバー設定 → 連携サービス → ウェブフックを作成してURLを貼る
DISCORD_WEBHOOK_URL=

# ===== オプション =====
# この金額(SOL)未満の送金は無視する
MIN_FUNDING_SOL=0.01
# 資金追跡の深さ。1=出金元→送金先のみ。2=送金先からさらに先の送金も追う
WATCH_DEPTH=1
# 監視ウォレット数の上限
MAX_WATCHED=500
# ウォレット追加時にも通知するか (true/false)
NOTIFY_ON_FUNDING=true
